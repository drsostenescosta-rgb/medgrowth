# Copie para .env e preencha. NUNCA commite chaves reais (o .gitignore já bloqueia .env).
# NUNCA imprima valores de chaves em logs.

# Anthropic — se ficar vazio aqui, o circuito usa a ANTHROPIC_API_KEY de ~/.env (o .env local prevalece).
# A chave precisa ser VÁLIDA: valide o setup com `node emily.mjs --check` (detecta chave morta/401).
ANTHROPIC_API_KEY=

# Supabase projeto sosmed (yaqphldowpshhrtvvfaq). Service key APENAS via variável de ambiente.
SUPABASE_URL=https://yaqphldowpshhrtvvfaq.supabase.co
SUPABASE_SERVICE_KEY=

# UUID do docgrow_profiles dono da agenda (obrigatório p/ espelhar consultas em docgrow_consultas)
DOCGROW_PROFILE_ID=

# Modelos (padrão: claude-sonnet-4-5 nos dois; o especialista roda com extended thinking)
EMILY_MODEL=claude-sonnet-4-5
EMILY_MODEL_ESPECIALISTA=claude-sonnet-4-5

# Webhook WhatsApp Cloud API (fase 2 — DESLIGADO por padrão)
WEBHOOK_ENABLED=false
WEBHOOK_PORT=3789
WEBHOOK_VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App secret do app Meta — OBRIGATÓRIO na fase 2: valida a assinatura X-Hub-Signature-256 de todo POST
# (sem isso o webhook RECUSA subir — POST forjado não pode virar mensagem processada)
WHATSAPP_APP_SECRET=
# Webhook de alerta imediato (Slack/Discord/qualquer endpoint que aceite POST {text}) — OBRIGATÓRIO
# na fase 2 (urgência médica notifica a dona NA HORA, jornada H2); recomendado já na fase 1
ALERTA_WEBHOOK_URL=
